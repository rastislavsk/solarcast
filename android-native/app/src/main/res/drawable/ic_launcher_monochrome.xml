    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">

        <path
            android:pathData="M12,12 L18.6,5.4 A9.3,9.3 0 0 0 5.4,5.4 Z"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.55" />
        <path
            android:pathData="M12,12 L18.6,18.6 A9.3,9.3 0 0 0 18.6,5.4 Z"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M12,2 A10,10 0 1 1 11.99,2 Z"
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.9"
            android:strokeWidth="1.4" />
