<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Everything the app talks to is HTTPS: the Open-Meteo forecast and
         geocoding endpoints, and Google Fonts. Nothing may fall back to
         cleartext, on any API level. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
