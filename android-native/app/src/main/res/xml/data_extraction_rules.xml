<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above. Same rule for cloud backup and for direct device
    transfer: carry the saved system, leave every cache behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
