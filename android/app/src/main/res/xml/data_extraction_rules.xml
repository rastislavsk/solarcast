<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and above. Same rule for cloud backup and for direct device
    transfer: carry the saved system, leave every cache behind. Anything not
    named here is excluded by definition.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="app_webview/Default/Local Storage" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="app_webview/Default/Local Storage" />
    </device-transfer>
</data-extraction-rules>
