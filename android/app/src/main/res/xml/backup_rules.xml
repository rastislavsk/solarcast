<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and below. Naming an <include> makes everything else implicitly
    excluded, so the HTTP cache and the service worker store stay out without
    listing them: the only thing worth carrying to a new device is the saved
    system in localStorage.
-->
<full-backup-content>
    <include domain="file" path="app_webview/Default/Local Storage" />
</full-backup-content>
